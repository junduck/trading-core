{
  "name": "@junduck/trading-core",
  "version": "2.5.2",
  "description": "Foundation data structures and utilities for spot market trading bookkeeping, backtesting, and algorithmic trading",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./trading": {
      "types": "./dist/trading.d.ts",
      "import": "./dist/trading.js"
    },
    "./algorithm": {
      "types": "./dist/algorithm.d.ts",
      "import": "./dist/algorithm.js"
    },
    "./containers": {
      "types": "./dist/containers.d.ts",
      "import": "./dist/containers.js"
    },
    "./online": {
      "types": "./dist/online.d.ts",
      "import": "./dist/online.js"
    },
    "./rolling": {
      "types": "./dist/rolling.d.ts",
      "import": "./dist/rolling.js"
    },
    "./batch": {
      "types": "./dist/batch.d.ts",
      "import": "./dist/batch.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "examples": "tsx examples.ts",
    "docs": "typedoc",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "trading",
    "backtest",
    "portfolio",
    "position",
    "spot-market",
    "bookkeeping",
    "finance",
    "investment",
    "algorithm",
    "statistics",
    "rolling-window",
    "technical-analysis",
    "data-structures"
  ],
  "author": "Jun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junduck/trading-core.git"
  },
  "bugs": {
    "url": "https://github.com/junduck/trading-core/issues"
  },
  "homepage": "https://github.com/junduck/trading-core#readme",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.7",
    "@vitest/ui": "^4.0.7",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  }
}
